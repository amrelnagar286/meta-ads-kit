# ─── Meta API Credentials ───────────────────────────────
# Get your access token from: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=your_access_token_here
META_AD_ACCOUNT_ID=act_your_account_id
META_API_VERSION=v25.0

# Optional: App credentials (for long-lived tokens)
META_APP_ID=
META_APP_SECRET=

# ─── Application Settings ──────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS_PER_HOUR=180

# ─── Google Sheets (Optional) ──────────────────────────
# Path to Google service account JSON credentials
GOOGLE_SHEETS_CREDENTIALS=config/google_credentials.json
